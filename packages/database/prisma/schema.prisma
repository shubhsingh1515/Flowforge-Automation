// Prisma Schema for FlowForge Automation - Phase 4 Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  SUCCESS
  FAILED
  CANCELLED
}

enum IntegrationStatus {
  AVAILABLE
  PLANNED
  BETA
}

enum AuthType {
  NONE
  API_KEY
  OAUTH2
  BEARER_TOKEN
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMembership[]
  sessions    Session[]
  ssoIdentities SsoUserIdentity[]
  notifications Notification[]
  customerFeedback CustomerFeedback[]
  organizationMemberships OrganizationMembership[]
  teamMemberships         TeamMember[]
  workflowReviewsAuthored WorkflowReview[] @relation("ReviewAuthor")
  workflowReviewsReviewed WorkflowReview[] @relation("ReviewReviewer")
  reviewComments          WorkflowReviewComment[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  // Phase 16: Regional Placement & Advanced Capacity
  homeRegion              String                @default("us-east-1")
  dataResidency           String                @default("GLOBAL")
  failoverRegion          String?
  failoverEpoch           Int                   @default(0)
  maxConcurrentExecutions Int?
  workloadPriority        String                @default("STANDARD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       WorkspaceMembership[]
  workflows         Workflow[]
  connectedAccounts ConnectedAccount[]
  subscription      WorkspaceSubscription?
  usageRecords      UsageRecord[]
  invitations       WorkspaceInvitation[]
  templates          WorkflowTemplate[]
  onboarding         WorkspaceOnboarding?
  apiKeys            ApiKey[]
  outboundWebhooks   OutboundWebhook[]
  customIntegrations CustomIntegration[]
  auditLogs          WorkspaceAuditLog[]
  marketplaceListings    MarketplaceListing[] @relation("WorkspaceMarketplaceListings")
  marketplaceInstalls    MarketplaceInstallation[]
  governancePolicy       WorkspaceGovernancePolicy?
  retentionPolicy        WorkspaceRetentionPolicy?
  dataExportRequests     DataExportRequest[]
  deletionRequests       WorkspaceDeletionRequest[]
  ssoProvider            WorkspaceSsoProvider?
  ssoIdentities          SsoUserIdentity[]
  ssoAuthStates          SsoAuthorizationState[]
  scimTokens             ScimProvisioningToken[]
  usageAlertConfig       WorkspaceUsageAlertConfig?
  usageAlertEvents       WorkspaceUsageAlertEvent[]
  notifications          Notification[]
  customerFeedback       CustomerFeedback[]
  supportBundles         SupportBundle[]
  environments           WorkflowEnvironment[]
  releaseArtifacts       WorkflowReleaseArtifact[]
  deployments            WorkflowDeployment[]
  deploymentPolicies     DeploymentPolicy[]
  testCases              WorkflowTestCase[]
  testRuns               WorkflowTestRun[]
  teams                  Team[]
  resourcePermissions    ResourcePermission[]
  workflowReviews        WorkflowReview[]
  reliabilityObjectives  ReliabilityObjective[]
  complianceExportJobs   ComplianceExportJob[]
  outboxEvents           TransactionalOutboxEvent[]
  backupVerifications    BackupVerificationRecord[]
  recoveryAuditRecords   RecoveryAuditRecord[]
  // Phase 17: Enterprise Data Residency, CMEK & Compliance
  residencyPolicy        WorkspaceResidencyPolicy?
  cmekConfig             WorkspaceCmekConfig?
  cmekRotationJobs       CmekRotationJob[]
  residencyAuditRecords  ResidencyAuditRecord[]
  complianceEvidence     ComplianceEvidenceRecord[]
  // Phase 18: Enterprise Observability 2.0 & Self-Healing
  operationalIncidents   OperationalIncident[]
  remediationPolicy      RemediationPolicy?
  remediationOperations  RemediationOperation[]
  capacityWarnings       OperationalCapacityWarning[]
  // Phase 19: Enterprise Integration Developer Platform & Connector SDK
  connectorArtifacts     ConnectorReleaseArtifact[]
  connectorMetrics       ConnectorExecutionMetric[]
  // Phase 20: Enterprise Digital Twin, Simulation, Chaos & Optimization
  simulationScenarios    WorkflowSimulationScenario[]
  simulationRuns         WorkflowSimulationRun[]
  chaosExperiments       ChaosExperiment[]
  optimizationCandidates WorkflowOptimizationCandidate[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

model Workflow {
  id            String         @id @default(uuid())
  workspaceId   String
  name          String
  description   String?
  status        WorkflowStatus @default(DRAFT)
  triggerType   String?
  webhookSlug   String?        @unique
  webhookSecret String?
  ownerUserId       String?
  owningTeamId      String?
  stewardUserId     String?
  criticality       String         @default("TIER_3_STANDARD")
  businessDomain    String?
  lifecycleStatus   String         @default("DRAFT")
  nextReviewDate    DateTime?
  escalationContact String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions          WorkflowVersion[]
  executions        WorkflowExecution[]
  webhookReceipts   WebhookEventReceipt[]
  scheduledTriggers ScheduledTrigger[]
  approvals         WorkflowApproval[]
  releaseArtifacts  WorkflowReleaseArtifact[]
  deployments       WorkflowDeployment[]
  testCases         WorkflowTestCase[]
  testRuns          WorkflowTestRun[]
  owningTeam        Team?                  @relation("TeamWorkflows", fields: [owningTeamId], references: [id], onDelete: SetNull)
  reviews           WorkflowReview[]
  reliabilityObjectives ReliabilityObjective[]
  // Phase 20
  simulationScenarios    WorkflowSimulationScenario[]
  simulationRuns         WorkflowSimulationRun[]
  optimizationCandidates WorkflowOptimizationCandidate[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("workflows")
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String
  version       Int      @default(1)
  changeSummary String?
  createdById   String?
  nodes      Json     @default("[]")
  edges      Json     @default("[]")
  viewport   Json?
  isValid    Boolean  @default(true)
  createdAt  DateTime @default(now())

  workflow   Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions       WorkflowExecution[]
  releaseArtifacts WorkflowReleaseArtifact[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model IntegrationDefinition {
  id               String            @id @default(uuid())
  key              String            @unique
  name             String
  description      String
  category         String
  status           IntegrationStatus @default(AVAILABLE)
  authType         AuthType          @default(NONE)
  isBuiltin        Boolean           @default(false)
  iconName         String
  accentColor      String            @default("#6366f1")
  documentationUrl String?
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("integration_definitions")
}

model ConnectedAccount {
  id             String    @id @default(uuid())
  workspaceId    String
  integrationKey String
  name           String
  credentials    Json      @default("{}") // AES-256-GCM encrypted tokens & secrets
  metadata       Json      @default("{}") // Identity metadata (account email, team name, user id)
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, ERROR
  scopes         String[]  @default([])
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace          Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentialBindings EnvironmentCredentialBinding[]

  @@index([workspaceId])
  @@index([workspaceId, integrationKey])
  @@map("connected_accounts")
}

model OAuthAuthorizationState {
  id           String   @id @default(uuid())
  state        String   @unique
  provider     String
  workspaceId  String
  userId       String
  codeVerifier String?
  redirectUri  String?
  metadata     Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([state])
  @@index([workspaceId])
  @@map("oauth_authorization_states")
}

model WebhookEventReceipt {
  id          String   @id @default(uuid())
  workflowId  String
  eventId     String
  sourceIp    String?
  headers     Json?
  payload     Json?
  executionId String?
  createdAt   DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, eventId])
  @@index([workflowId, createdAt])
  @@map("webhook_event_receipts")
}

model ScheduledTrigger {
  id             String    @id @default(uuid())
  workflowId     String
  cronExpression String
  timezone       String    @default("UTC")
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  status         String    @default("ACTIVE")
  jobId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status, nextRunAt])
  @@map("scheduled_triggers")
}

model WorkflowExecution {
  id                 String          @id @default(uuid())
  workflowId         String
  versionId          String?
  environmentId      String?
  releaseArtifactId  String?
  status             ExecutionStatus @default(PENDING)
  attempt            Int             @default(1)
  maxAttempts        Int             @default(3)
  retryOfId          String?
  correlationId      String?
  traceparent        String?
  diagnostics        Json?
  timeline           Json?
  errorCategory      String?
  triggerEvent       Json?
  errorSummary       String?
  executionTrace     Json?
  executionState     Json?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  resumedAt          DateTime?
  nextRetryAt        DateTime?
  // Phase 15: Worker Leasing, Fencing & Checkpoints
  leaseOwner           String?
  leaseToken           Int             @default(0)
  leaseExpiresAt       DateTime?
  recoveryAttempts     Int             @default(0)
  lastCheckpointNodeId String?
  // Phase 16: Regional Execution & Failover Epoch
  executionRegion      String          @default("us-east-1")
  failoverEpoch        Int             @default(0)
  startedAt          DateTime        @default(now())
  finishedAt         DateTime?
  durationMs         Int?
  createdAt          DateTime        @default(now())

  workflow  Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version   WorkflowVersion?        @relation(fields: [versionId], references: [id], onDelete: SetNull)
  steps     WorkflowStepExecution[]
  approvals WorkflowApproval[]

  @@index([workflowId, status])
  @@index([workflowId, createdAt])
  @@index([correlationId])
  @@index([status, leaseExpiresAt])
  @@index([leaseOwner])
  @@map("workflow_executions")
}

model WorkflowStepExecution {
  id            String          @id @default(uuid())
  executionId   String
  nodeId        String
  nodeName      String
  nodeType      String
  status        ExecutionStatus @default(PENDING)
  attempt       Int             @default(1)
  correlationId String?
  errorCategory String?
  inputData     Json?
  outputData    Json?
  errorMessage  String?
  iteration     Int?
  branch        String?
  durationMs    Int?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("workflow_step_executions")
}

model WorkflowApproval {
  id              String          @id @default(uuid())
  workspaceId     String
  workflowId      String
  executionId     String
  nodeId          String
  stepId          String?
  title           String
  description     String?
  context         Json?
  status          String          @default("PENDING") // PENDING, APPROVED, REJECTED, TIMED_OUT, CANCELLED
  requiredRole    WorkspaceRole?
  decision        String?         // APPROVED, REJECTED
  comment         String?
  decidedByUserId String?
  decidedAt       DateTime?
  timeoutSeconds  Int?
  expiresAt       DateTime?
  resumeNodeId    String?
  rejectNodeId    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([executionId])
  @@index([status, expiresAt])
  @@map("workflow_approvals")
}

model WorkspaceSubscription {
  id                   String             @id @default(uuid())
  workspaceId          String             @unique
  planTier             PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("workspace_subscriptions")
}

model UsageRecord {
  id             String   @id @default(uuid())
  workspaceId    String
  metricType     String   @default("WORKFLOW_EXECUTION") // WORKFLOW_EXECUTION, STEP_EXECUTION
  quantity       Int      @default(1)
  executionId    String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, metricType])
  @@map("usage_records")
}

model BillingWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  provider    String   @default("STRIPE")
  payload     Json?
  processedAt DateTime @default(now())

  @@index([eventType])
  @@map("billing_webhook_events")
}

model WorkspaceInvitation {
  id              String           @id @default(uuid())
  workspaceId     String
  email           String
  role            WorkspaceRole    @default(MEMBER)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
  @@map("workspace_invitations")
}


model WorkflowTemplate {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  title                String
  description          String
  category             String
  tags                 String[] @default([])
  difficulty           String   @default("BEGINNER")
  triggerType          String
  actionType           String
  requiredIntegrations String[] @default([])
  setupGuide           String?
  nodes                Json     @default("[]")
  edges                Json     @default("[]")
  isPlatform           Boolean  @default(false)
  reviewStatus         String   @default("PUBLISHED")
  publisherName        String?
  version              Int      @default(1)
  workspaceId          String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace            Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([workspaceId])
  @@index([isPlatform])
  @@map("workflow_templates")
}

model WorkspaceOnboarding {
  id                   String   @id @default(uuid())
  workspaceId          String   @unique
  hasCreatedWorkflow   Boolean  @default(false)
  hasTestedWorkflow    Boolean  @default(false)
  hasActivatedWorkflow Boolean  @default(false)
  hasConnectedAccount  Boolean  @default(false)
  hasUsedTemplate      Boolean  @default(false)
  hasInvitedMember     Boolean  @default(false)
  dismissed            Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_onboarding")
}


model ApiKey {
  id          String    @id @default(uuid())
  name        String
  keyPrefix   String
  keyHash     String    @unique
  workspaceId String
  createdById String
  scopes      String[]  @default([])
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model OutboundWebhook {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  url         String
  secret      String
  events      String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId, active])
  @@map("outbound_webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String
  workspaceId  String
  eventId      String
  eventType    String
  payload      Json
  status       String    @default("PENDING")
  statusCode   Int?
  responseBody String?
  errorMessage String?
  attempt      Int       @default(1)
  maxAttempts  Int       @default(3)
  durationMs   Int?
  nextRetryAt  DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([workspaceId, createdAt])
  @@index([eventId])
  @@map("webhook_deliveries")
}

model CustomIntegration {
  id             String   @id @default(uuid())
  workspaceId    String
  key            String
  name           String
  description    String?
  category       String   @default("Custom")
  status         String   @default("DRAFT")
  currentVersion Int      @default(1)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  CustomIntegrationVersion[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("custom_integrations")
}

model CustomIntegrationVersion {
  id            String   @id @default(uuid())
  integrationId String
  version       Int      @default(1)
  definition    Json     @default("{}")
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())

  integration CustomIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, version])
  @@map("custom_integration_versions")
}

model WorkspaceAuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorId     String
  actorType   String   @default("USER")
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("workspace_audit_logs")
}


// ==========================================
// PHASE 9: MARKETPLACE & GOVERNANCE MODELS
// ==========================================

model MarketplaceListing {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  title                 String
  description           String
  category              String   @default("Productivity")
  iconName              String   @default("Puzzle")
  accentColor           String   @default("#6366f1")
  publisherName         String   @default("FlowForge Platform")
  publisherWorkspaceId  String?
  integrationKey        String?
  customIntegrationId   String?
  currentVersion        Int      @default(1)
  visibility            String   @default("PUBLIC") // PUBLIC, WORKSPACE, PRIVATE
  reviewStatus          String   @default("PUBLISHED") // DRAFT, IN_REVIEW, PUBLISHED, REJECTED, DEPRECATED, UNPUBLISHED
  rejectionReason       String?
  capabilities          String[] @default([])
  supportedTriggers     String[] @default([])
  supportedActions      String[] @default([])
  authRequirements      String   @default("OAuth 2.0 or API Key")
  documentationUrl      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  publisherWorkspace    Workspace? @relation("WorkspaceMarketplaceListings", fields: [publisherWorkspaceId], references: [id], onDelete: SetNull)
  installations         MarketplaceInstallation[]

  @@index([category])
  @@index([reviewStatus])
  @@index([visibility])
  @@map("marketplace_listings")
}

model MarketplaceInstallation {
  id               String   @id @default(uuid())
  workspaceId      String
  listingId        String
  installedVersion Int      @default(1)
  installedArtifactId String?
  settings            Json?
  status           String   @default("ACTIVE") // ACTIVE, DISABLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, listingId])
  @@index([workspaceId])
  @@map("marketplace_installations")
}

model WorkspaceGovernancePolicy {
  id                          String   @id @default(uuid())
  workspaceId                 String   @unique
  allowCustomIntegrations     Boolean  @default(true)
  allowMarketplacePublishing  Boolean  @default(false)
  allowCommunityTemplates     Boolean  @default(true)
  requireHttpsWebhooks        Boolean  @default(true)
  maxApiKeyLifetimeDays       Int?     @default(365)
  restrictIntegrationsToAdmin Boolean  @default(false)
  requireWorkflowOwner        Boolean  @default(false)
  requireReviewForCritical    Boolean  @default(true)
  requirePassingTests         Boolean  @default(false)
  enforceReliabilitySlo       Boolean  @default(false)
  maxExecutionDurationMs      Int?     @default(300000)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_governance_policies")
}

model WorkspaceRetentionPolicy {
  id                           String   @id @default(uuid())
  workspaceId                  String   @unique
  executionRetentionDays       Int      @default(30)
  webhookDeliveryRetentionDays  Int      @default(14)
  auditLogRetentionDays        Int      @default(90)
  // Phase 17: Legal Holds & Granular Retention
  legalHold                    Boolean  @default(false)
  legalHoldReason              String?
  legalHoldSetById             String?
  legalHoldSetAt               DateTime?
  payloadRetentionDays         Int      @default(30)
  diagnosticsRetentionDays     Int      @default(14)
  exportRetentionDays          Int      @default(7)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_retention_policies")
}

model DataExportRequest {
  id            String    @id @default(uuid())
  workspaceId   String
  requestedById String
  status        String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  downloadUrl   String?
  fileSizeBytes Int?
  recordCount   Int?
  errorMessage  String?
  expiresAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("data_export_requests")
}

model WorkspaceDeletionRequest {
  id                  String    @id @default(uuid())
  workspaceId         String
  requestedById       String
  status              String    @default("PENDING") // PENDING, CONFIRMED, PROCESSING, COMPLETED, CANCELLED
  confirmationToken   String?
  reason              String?
  scheduledDeletionAt DateTime?
  confirmedAt         DateTime?
  createdAt           DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("workspace_deletion_requests")
}


// ==========================================
// PHASE 10: ENTERPRISE IDENTITY & RELIABILITY
// ==========================================

model WorkspaceSsoProvider {
  id                            String   @id @default(uuid())
  workspaceId                   String   @unique
  name                          String   @default("Enterprise OIDC")
  issuerUrl                     String
  authorizationEndpoint         String
  tokenEndpoint                 String
  userinfoEndpoint              String?
  clientId                      String
  encryptedClientSecret         String
  scopes                        String   @default("openid email profile")
  enforceSso                    Boolean  @default(false)
  allowPasswordFallbackForAdmins Boolean @default(true)
  lastTestedAt                  DateTime?
  lastTestStatus                String?
  lastTestError                 String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  identities SsoUserIdentity[]

  @@map("workspace_sso_providers")
}

model SsoUserIdentity {
  id                  String   @id @default(uuid())
  userId              String
  workspaceId         String
  providerId          String
  externalSubjectId   String
  externalEmail       String
  metadata            Json?
  lastAuthenticatedAt DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider  WorkspaceSsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, externalSubjectId])
  @@index([userId])
  @@index([workspaceId, externalEmail])
  @@map("sso_user_identities")
}

model SsoAuthorizationState {
  id           String   @id @default(uuid())
  workspaceId  String
  state        String   @unique
  nonce        String
  codeVerifier String?
  redirectUri  String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([workspaceId])
  @@map("sso_authorization_states")
}

model ScimProvisioningToken {
  id          String    @id @default(uuid())
  workspaceId String
  name        String    @default("Primary SCIM Token")
  tokenHash   String    @unique
  tokenPrefix String
  status      String    @default("ACTIVE")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("scim_provisioning_tokens")
}

model ExecutionReconciliationLog {
  id             String   @id @default(uuid())
  executionId    String
  workflowId     String
  workspaceId    String
  previousStatus String
  newStatus      String
  reason         String
  actionTaken    String
  reconciledAt   DateTime @default(now())

  @@index([workspaceId, reconciledAt])
  @@index([executionId])
  @@map("execution_reconciliation_logs")
}

model OperationalAlertRule {
  id              String   @id @default(uuid())
  metricName      String
  operator        String
  threshold       Float
  durationMinutes Int      @default(5)
  severity        String   @default("WARNING")
  isEnabled       Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("operational_alert_rules")
}

// ==========================================
// PHASE 11: CUSTOMER SUCCESS, USAGE INTELLIGENCE & NOTIFICATIONS
// ==========================================

model WorkspaceUsageAlertConfig {
  id           String   @id @default(uuid())
  workspaceId  String   @unique
  threshold50  Boolean  @default(true)
  threshold80  Boolean  @default(true)
  threshold90  Boolean  @default(true)
  threshold100 Boolean  @default(true)
  notifyEmail  Boolean  @default(true)
  notifyInApp  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_usage_alert_configs")
}

model WorkspaceUsageAlertEvent {
  id               String   @id @default(uuid())
  workspaceId      String
  billingCycleKey  String   // e.g. "2026-10" or timestamp cycle
  thresholdPercent Int      // 50, 80, 90, 100
  executionsCount  Int
  quotaLimit       Int
  triggeredAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, billingCycleKey, thresholdPercent])
  @@index([workspaceId, billingCycleKey])
  @@map("workspace_usage_alert_events")
}

model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String?   // null indicates notification applies to all workspace members
  type        String    // USAGE_ALERT, EXECUTION_FAILED, APPROVAL_REQUESTED, WEBHOOK_FAILED, DATA_EXPORT, SYSTEM
  title       String
  message     String
  link        String?
  category    String    @default("info") // info, warning, error, success
  read        Boolean   @default(false)
  readAt      DateTime?
  metadata    Json?     @default("{}")
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, read, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

model CustomerFeedback {
  id           String   @id @default(uuid())
  workspaceId  String
  userId       String
  category     String   // BUG, FEATURE_REQUEST, USABILITY, GENERAL
  rating       Int?     // 1 to 5
  comment      String
  contactEmail String?
  metadata     Json?    @default("{}")
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("customer_feedback")
}

model SupportBundle {
  id                String   @id @default(uuid())
  workspaceId       String
  requestedByUserId String
  status            String   @default("COMPLETED")
  summary           String
  payload           Json     // sanitized workspace diagnostic payload
  sizeBytes         Int      @default(0)
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@map("support_bundles")
}



// ==========================================
// PHASE 12: WORKFLOW ENVIRONMENTS & DEPLOYMENTS
// ==========================================

model WorkflowEnvironment {
  id                      String   @id @default(uuid())
  workspaceId             String
  name                    String
  slug                    String
  type                    String   @default("DEVELOPMENT") // DEVELOPMENT, STAGING, PRODUCTION, CUSTOM
  description             String?
  isProtected             Boolean  @default(false)
  requireApproval         Boolean  @default(false)
  requirePassingTests     Boolean  @default(false)
  activeReleaseArtifactId String?
  deployedAt              DateTime?
  deployedByUserId        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace               Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variables               EnvironmentVariable[]
  bindings                EnvironmentCredentialBinding[]
  deployments             WorkflowDeployment[]
  testRuns                WorkflowTestRun[]
  policy                  DeploymentPolicy?
  chaosExperiments        ChaosExperiment[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, type])
  @@map("workflow_environments")
}

model EnvironmentVariable {
  id              String   @id @default(uuid())
  workspaceId     String
  environmentId   String
  key             String
  value           String   // Plaintext or AES-256-GCM ciphertext
  isSecret        Boolean  @default(false)
  description     String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  environment     WorkflowEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([workspaceId])
  @@index([environmentId])
  @@map("environment_variables")
}

model EnvironmentCredentialBinding {
  id                 String   @id @default(uuid())
  workspaceId        String
  environmentId      String
  integrationKey     String
  connectedAccountId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  environment        WorkflowEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount    @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([environmentId, integrationKey])
  @@index([workspaceId])
  @@index([connectedAccountId])
  @@map("environment_credential_bindings")
}

model WorkflowReleaseArtifact {
  id                  String   @id @default(uuid())
  workspaceId         String
  workflowId          String
  workflowVersionId   String?
  versionNumber       Int
  releaseNumber       Int
  formatVersion       String   @default("flowforge.release/v1")
  contentHash         String
  canonicalDefinition Json
  summary             String?
  status              String   @default("READY") // READY, DEPRECATED
  createdById         String?
  createdAt           DateTime @default(now())

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow            Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion     WorkflowVersion?     @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  deployments         WorkflowDeployment[]
  testRuns            WorkflowTestRun[]
  simulationRuns      WorkflowSimulationRun[]

  @@unique([workflowId, releaseNumber])
  @@index([workspaceId, contentHash])
  @@index([workflowId, createdAt])
  @@map("workflow_release_artifacts")
}

model WorkflowDeployment {
  id                        String    @id @default(uuid())
  workspaceId               String
  workflowId                String
  releaseArtifactId         String
  environmentId             String
  status                    String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, DEPLOYING, DEPLOYED, FAILED, CANCELLED, ROLLED_BACK, SUPERSEDED
  previousReleaseArtifactId String?
  diffSummary               Json?
  validationResults         Json?
  initiatedByUserId         String
  approvedByUserId          String?
  approvedAt                DateTime?
  rollbackOfDeploymentId    String?
  deployedAt                DateTime?
  completedAt               DateTime?
  failureReason             String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  workspace                 Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow                  Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  releaseArtifact           WorkflowReleaseArtifact @relation(fields: [releaseArtifactId], references: [id], onDelete: Cascade)
  environment               WorkflowEnvironment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, environmentId, status])
  @@index([workflowId, environmentId])
  @@index([releaseArtifactId])
  @@map("workflow_deployments")
}

model DeploymentPolicy {
  id                   String   @id @default(uuid())
  workspaceId          String
  environmentId        String   @unique
  requireApproval      Boolean  @default(false)
  requirePassingTests  Boolean  @default(false)
  preventSelfApproval            Boolean  @default(true)
  requireSimulationCoverage      Boolean  @default(false)
  prohibitUnsimulatableNodes     Boolean  @default(false)
  requireChaosExperimentEvidence Boolean  @default(false)
  allowedPromoterRoles String[] @default(["OWNER", "ADMIN", "MEMBER"])
  allowedApproverRoles String[] @default(["OWNER", "ADMIN"])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment          WorkflowEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("deployment_policies")
}

model WorkflowTestCase {
  id             String   @id @default(uuid())
  workspaceId    String
  workflowId     String
  name           String
  description    String?
  triggerPayload Json     @default("{}")
  mockOutputs    Json     @default("{}")
  expectedStatus String   @default("SUCCESS") // SUCCESS, FAILED
  assertions     Json     @default("[]")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow       Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  testRuns       WorkflowTestRun[]

  @@index([workflowId])
  @@index([workspaceId])
  @@map("workflow_test_cases")
}

model WorkflowTestRun {
  id                 String   @id @default(uuid())
  workspaceId        String
  workflowId         String
  testCaseId         String
  releaseArtifactId  String?
  releaseContentHash String?
  environmentId      String?
  mode               String   @default("DRY_RUN") // DRY_RUN, MOCKED, REAL_INTEGRATION
  status             String   // PASSED, FAILED, ERROR
  assertionResults   Json     @default("[]")
  nodeResults        Json     @default("{}")
  durationMs         Int      @default(0)
  errorMessage       String?
  executedByUserId   String?
  createdAt          DateTime @default(now())

  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow           Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  testCase           WorkflowTestCase         @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  releaseArtifact    WorkflowReleaseArtifact? @relation(fields: [releaseArtifactId], references: [id], onDelete: SetNull)
  environment        WorkflowEnvironment?     @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([testCaseId, status])
  @@index([releaseContentHash, status])
  @@index([workspaceId])
  @@map("workflow_test_runs")
}

// ==========================================
// PHASE 14: ENTERPRISE COLLABORATION & GOVERNANCE
// ==========================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  // Phase 16: Regional Placement
  homeRegion String   @default("us-east-1")
  dataResidency String @default("GLOBAL")
  failoverRegion String?
  failoverEpoch Int    @default(0)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces  Workspace[]
  memberships OrganizationMembership[]
  teams       Team[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String?
  workspaceId    String
  name           String
  slug           String
  description    String?
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  workflows    Workflow[]    @relation("TeamWorkflows")

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER") // LEAD, MEMBER
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model ResourcePermission {
  id           String   @id @default(uuid())
  workspaceId  String
  resourceType String   // WORKFLOW, ENVIRONMENT, FOLDER
  resourceId   String
  subjectType  String   // USER, TEAM
  subjectId    String
  actions      String[] @default(["VIEW"]) // VIEW, EDIT, RUN, APPROVE, DEPLOY, MANAGE_PERMISSIONS
  grantedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resourceType, resourceId])
  @@index([subjectType, subjectId])
  @@map("resource_permissions")
}

model WorkflowReview {
  id                    String    @id @default(uuid())
  workspaceId           String
  workflowId            String
  workflowVersionNumber Int
  releaseArtifactId     String?
  contentHash           String
  title                 String
  changeSummary         String?
  authorUserId          String
  status                String    @default("SUBMITTED") // SUBMITTED, CHANGES_REQUESTED, APPROVED, REJECTED, SUPERSEDED
  reviewerUserId        String?
  decisionReason        String?
  decidedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  author    User                    @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  reviewer  User?                   @relation("ReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  comments  WorkflowReviewComment[]

  @@index([workspaceId, workflowId, status])
  @@index([contentHash])
  @@map("workflow_reviews")
}

model WorkflowReviewComment {
  id           String   @id @default(uuid())
  reviewId     String
  authorUserId String
  nodeId       String?
  comment      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  review WorkflowReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("workflow_review_comments")
}

model ReliabilityObjective {
  id                   String    @id @default(uuid())
  workspaceId          String
  workflowId           String?
  name                 String
  targetMetric         String    // SUCCESS_RATE, P95_LATENCY, MAX_DURATION
  targetValue          Float
  evaluationWindowDays Int       @default(14)
  status               String    @default("MET") // MET, AT_RISK, BREACHED, INSUFFICIENT_DATA
  currentValue         Float?
  errorBudgetRemaining Float?
  lastEvaluatedAt      DateTime?
  alertCooldownUntil   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workflowId])
  @@map("reliability_objectives")
}

model ComplianceExportJob {
  id                String    @id @default(uuid())
  workspaceId       String
  requestedByUserId String
  scope             String    @default("ALL") // AUDIT_LOGS, GOVERNANCE, REVIEWS, RELEASES, FULL
  timeRangeStart    DateTime
  timeRangeEnd      DateTime
  status            String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, EXPIRED
  downloadToken     String?   @unique
  fileSizeBytes     Int?
  recordCount       Int?
  sanitizedPayload  Json?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("compliance_export_jobs")
}


// ==========================================
// Phase 15: Enterprise Reliability & Disaster Recovery
// ==========================================

model TransactionalOutboxEvent {
  id             String    @id @default(uuid())
  workspaceId    String
  eventType      String
  payload        Json      @default("{}")
  idempotencyKey String    @unique
  status         String    @default("PENDING") // PENDING, PROCESSING, DELIVERED, FAILED, DEAD_LETTER
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status, nextRetryAt])
  @@index([status, createdAt])
  @@map("transactional_outbox_events")
}

model BackupVerificationRecord {
  id                 String    @id @default(uuid())
  workspaceId        String?
  backupFileName     String
  checksumSha256     String
  fileSizeBytes      Int?
  status             String    // VERIFIED, CORRUPTED, RESTORE_FAILED
  isolatedTargetDb   String?
  restoredTableCount Int?
  verificationReport Json?
  verifiedAt         DateTime  @default(now())
  durationMs         Int?
  errorMessage       String?
  triggeredByUserId  String?
  createdAt          DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([status, verifiedAt])
  @@index([workspaceId])
  @@map("backup_verification_records")
}

model RecoveryAuditRecord {
  id             String    @id @default(uuid())
  workspaceId    String?
  operationType  String    // EXECUTION_RECOVERY, OUTBOX_REPLAY, BACKUP_VERIFICATION, QUEUE_BACKPRESSURE_TRIP
  targetResource String
  operatorId     String?   // User ID or SYSTEM
  isDryRun       Boolean   @default(false)
  status         String    // SUCCESS, FAILED, PARTIAL
  details        Json?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([operationType, createdAt])
  @@index([workspaceId, createdAt])
  @@map("recovery_audit_records")
}


// ==========================================
// PHASE 16: ENTERPRISE SCALE, REGION READINESS & ADVANCED CAPACITY
// ==========================================

model RegionDeploymentConfig {
  id                         String    @id @default(uuid())
  regionKey                  String    @unique // us-east-1, eu-central-1, ap-southeast-1
  regionName                 String
  isAuthoritative            Boolean   @default(true)
  status                     String    @default("HEALTHY") // HEALTHY, DEGRADED, EVACUATING, STANDBY
  apiEndpoint                String?
  maxConnectionPool          Int       @default(50)
  queueBackpressureThreshold Int       @default(5000)
  drainRatePerSec            Float?
  activeTenantCount          Int       @default(0)
  currentEpoch               Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@map("region_deployment_configs")
}

model CapacityMetricSample {
  id                     String    @id @default(uuid())
  regionKey              String    @default("us-east-1")
  queueDepth             Int       @default(0)
  activeWorkers          Int       @default(1)
  avgProcessingTimeMs    Float     @default(0)
  projectedDrainTimeSec  Float     @default(0)
  dbConnectionSaturation Float     @default(0)
  workerSaturation       Float     @default(0)
  enqueueRatePerSec      Float     @default(0)
  completionRatePerSec   Float     @default(0)
  timestamp              DateTime  @default(now())

  @@index([regionKey, timestamp])
  @@map("capacity_metric_samples")
}

model RegionalFailoverDrillRecord {
  id                      String    @id @default(uuid())
  sourceRegion            String
  targetRegion            String
  failoverEpoch           Int
  status                  String    @default("COMPLETED") // IN_PROGRESS, COMPLETED, FAILED, ROLLED_BACK
  affectedWorkspacesCount Int       @default(0)
  fencedExecutionCount    Int       @default(0)
  durationMs              Int       @default(0)
  triggeredByUserId       String?
  notes                   String?
  createdAt               DateTime  @default(now())

  @@map("regional_failover_drill_records")
}


// ==========================================
// PHASE 17: DATA RESIDENCY, CMEK & ADVANCED COMPLIANCE
// ==========================================

model WorkspaceResidencyPolicy {
  id                            String   @id @default(uuid())
  workspaceId                   String   @unique
  homeRegion                    String   @default("us-east-1")
  permittedProcessingRegions     String[] @default(["us-east-1"])
  permittedStorageRegions        String[] @default(["us-east-1"])
  permittedBackupRegions         String[] @default(["us-east-1", "eu-central-1"])
  crossRegionReplicationAllowed  Boolean  @default(true)
  thirdPartyProcessingAllowed    Boolean  @default(true)
  status                        String   @default("ACTIVE") // ACTIVE, PENDING_REVIEW, NON_COMPLIANT
  policyVersion                 Int      @default(1)
  effectiveAt                   DateTime @default(now())
  lastVerifiedAt                DateTime?
  verificationStatus            String   @default("VERIFIED") // VERIFIED, VIOLATION, UNVERIFIED
  verificationEvidence          Json?
  updatedByUserId               String?
  changeReason                  String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_residency_policies")
}

model ResidencyAuditRecord {
  id               String   @id @default(uuid())
  workspaceId      String
  action           String   // POLICY_UPDATE, VERIFICATION_RUN, BOUNDARY_CHECK, REGION_MISMATCH_FENCE
  resourceType     String   // EXECUTION, WEBHOOK, EXPORT, BACKUP
  resourceId       String?
  requestedRegion  String
  enforcedRegion   String
  isCompliant      Boolean
  actorId          String?
  details          Json?
  createdAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([action, isCompliant])
  @@map("residency_audit_records")
}

model WorkspaceCmekConfig {
  id                      String    @id @default(uuid())
  workspaceId             String    @unique
  keyProvider             String    @default("LOCAL") // LOCAL, AWS_KMS, VAULT
  keyReference            String    // KMS Key ARN or local reference ID
  keyVersion              String    @default("1")
  keyStatus               String    @default("ACTIVE") // PENDING, ACTIVE, ROTATION_IN_PROGRESS, DISABLED, REVOKED, ERROR
  keyStateMetadata        Json?
  rotationEpoch           Int       @default(1)
  encryptedDataKey        String?   // Wrapped DEK
  encryptedDataKeyVersion  String?
  lastRotatedAt           DateTime?
  revokedAt               DateTime?
  revocationReason        String?
  registeredByUserId      String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_cmek_configs")
}

model CmekRotationJob {
  id                 String    @id @default(uuid())
  workspaceId        String
  previousKeyVersion String
  newKeyVersion      String
  status             String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED, PARTIAL
  totalRecords       Int       @default(0)
  reEncryptedRecords Int       @default(0)
  failedRecords      Int       @default(0)
  initiatedByUserId  String?
  completedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("cmek_rotation_jobs")
}

model ComplianceEvidenceRecord {
  id             String   @id @default(uuid())
  workspaceId    String
  evidenceType   String   // RESIDENCY_VERIFICATION, CMEK_LIFECYCLE, RETENTION_EXECUTION, LEGAL_HOLD
  scope          String
  status         String   // COMPLIANT, NON_COMPLIANT, UNVERIFIED
  details        Json
  checksumSha256 String
  actorId        String?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, evidenceType])
  @@index([createdAt])
  @@map("compliance_evidence_records")
}


// ==========================================
// PHASE 18: OBSERVABILITY 2.0 & SELF-HEALING
// ==========================================

model OperationalIncident {
  id                      String    @id @default(uuid())
  workspaceId             String
  title                   String
  severity                String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  status                  String    @default("OPEN")   // OPEN, ACKNOWLEDGED, INVESTIGATING, MITIGATING, RESOLVED, CLOSED
  category                String    @default("SLO_BREACH") // SLO_BREACH, WORKER_FAILURE, QUEUE_SATURATION, INTEGRATION_ERROR, OUTBOX_BACKLOG, REGIONAL_DEGRADATION
  sourceService           String    @default("EXECUTION_ENGINE")
  correlationKey          String
  rootCauseSummary        String?
  candidateCauses         Json?
  suggestedAction         String?
  affectedWorkflows       String[]  @default([])
  affectedRegions         String[]  @default([])
  assignedToUserId        String?
  acknowledgedAt          DateTime?
  resolvedAt              DateTime?
  closedAt                DateTime?
  metadata                Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timelineEvents          OperationalIncidentTimelineEvent[]
  remediationOperations   RemediationOperation[]

  @@index([workspaceId, status])
  @@index([correlationKey])
  @@index([createdAt])
  @@map("operational_incidents")
}

model OperationalIncidentTimelineEvent {
  id          String   @id @default(uuid())
  incidentId  String
  eventType   String   // ALERT_TRIGGERED, STATUS_CHANGED, NOTE_ADDED, REMEDIATION_TRIGGERED, REMEDIATION_COMPLETED, REMEDIATION_FAILED, ESCALATION_SENT
  actorId     String?
  actorType   String   @default("SYSTEM") // SYSTEM, USER, WORKER
  details     Json?
  createdAt   DateTime @default(now())

  incident    OperationalIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("operational_incident_timeline_events")
}

model RemediationPolicy {
  id                             String   @id @default(uuid())
  workspaceId                    String   @unique
  name                           String   @default("Default Safe Self-Healing Policy")
  autonomyMode                   String   @default("OBSERVE_ONLY") // OBSERVE_ONLY, APPROVAL_REQUIRED, POLICY_AUTOMATED
  allowedActions                 String[] @default(["RETRY_RETRYABLE_EXECUTION", "REPLAY_FAILED_OUTBOX_EVENT"])
  maxAutomatedActionsPerIncident Int      @default(3)
  cooldownMinutes                Int      @default(15)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  workspace                      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("remediation_policies")
}

model RemediationOperation {
  id                String    @id @default(uuid())
  workspaceId       String
  incidentId        String?
  actionKey         String    // RETRY_RETRYABLE_EXECUTION, REQUEUE_ABANDONED_JOB, REPLAY_FAILED_OUTBOX_EVENT, PAUSE_FAILING_DEPLOYMENT, SCALE_CONCURRENCY_BACKPRESSURE
  status            String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, EXECUTING, COMPLETED, FAILED, REJECTED, VERIFIED, UNVERIFIED
  riskLevel         String    @default("LOW") // LOW, MEDIUM, HIGH
  targetType        String    // EXECUTION, OUTBOX_EVENT, QUEUE_JOB, DEPLOYMENT, CONCURRENCY
  targetId          String
  parameters        Json?
  requestedByUserId String?
  approvedByUserId  String?
  approvedAt        DateTime?
  executedAt        DateTime?
  verifiedAt        DateTime?
  resultSummary     String?
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incident          OperationalIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([targetType, targetId])
  @@map("remediation_operations")
}

model OperationalCapacityWarning {
  id              String    @id @default(uuid())
  workspaceId     String?
  regionKey       String    @default("us-east-1")
  signalType      String    // QUEUE_AGE_SPIKE, DRAIN_TIME_DETERIORATION, OUTBOX_ACCUMULATION, WORKER_LEASE_SATURATION, DB_POOL_PRESSURE
  severity        String    @default("WARNING") // WARNING, CRITICAL
  currentValue    Float
  baselineValue   Float
  thresholdValue  Float
  confidence      String    @default("HIGH") // HIGH, MEDIUM, LOW, INSUFFICIENT_DATA
  recommendation  String
  isResolved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([regionKey, isResolved])
  @@index([workspaceId, signalType])
  @@map("operational_capacity_warnings")
}


// ==========================================
// PHASE 19: ENTERPRISE INTEGRATION DEVELOPER PLATFORM & CONNECTOR SDK
// ==========================================

model ConnectorReleaseArtifact {
  id                    String   @id @default(uuid())
  connectorKey          String
  version               String   // SemVer format: e.g. "1.0.0"
  manifest              Json
  artifactHashSha256    String
  status                String   @default("DRAFT") // DRAFT, CERTIFIED, PUBLISHED, SUSPENDED, REVOKED
  certificationStatus   String   @default("PENDING") // PENDING, PASSED, FAILED
  rejectionReason       String?
  suspensionReason      String?
  publisherWorkspaceId  String
  publishedAt           DateTime?
  publishedByUserId     String?
  customIntegrationId   String?
  marketplaceListingId  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  publisherWorkspace    Workspace                         @relation(fields: [publisherWorkspaceId], references: [id], onDelete: Cascade)
  certifications        ConnectorCertificationRecord[]
  metrics               ConnectorExecutionMetric[]

  @@unique([connectorKey, version])
  @@index([publisherWorkspaceId])
  @@index([status])
  @@index([artifactHashSha256])
  @@map("connector_release_artifacts")
}

model ConnectorCertificationRecord {
  id                 String   @id @default(uuid())
  artifactId         String
  overallResult      String   @default("IN_PROGRESS") // PASSED, FAILED, IN_PROGRESS
  checkerVersion     String   @default("1.0.0")
  artifactHashSha256 String
  reviewedByUserId   String?
  reviewNotes        String?
  reviewedAt         DateTime?
  createdAt          DateTime @default(now())

  artifact           ConnectorReleaseArtifact         @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  checks             ConnectorCertificationCheck[]

  @@index([artifactId, createdAt])
  @@map("connector_certification_records")
}

model ConnectorCertificationCheck {
  id          String   @id @default(uuid())
  recordId    String
  checkName   String   // MANIFEST_SCHEMA_VALIDITY, ACTION_TRIGGER_CONTRACTS, CREDENTIAL_SAFETY_AND_REDACTION, SSRF_AND_EGRESS_COMPLIANCE, TENANT_ISOLATION_AND_RESIDENCY, ARTIFACT_PROVENANCE_INTEGRITY
  status      String   // PASSED, FAILED, WARNING
  message     String
  details     Json?
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  record      ConnectorCertificationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("connector_certification_checks")
}

model ConnectorExecutionMetric {
  id            String   @id @default(uuid())
  connectorKey  String
  version       String
  workspaceId   String
  actionId      String
  status        String   // SUCCESS, FAILED
  durationMs    Int
  errorCategory String?
  artifactId    String?
  createdAt     DateTime @default(now())

  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifact      ConnectorReleaseArtifact?  @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([connectorKey, version])
  @@index([workspaceId, createdAt])
  @@map("connector_execution_metrics")
}

// ==========================================
// PHASE 20: ENTERPRISE WORKFLOW DIGITAL TWIN, SIMULATION & CHAOS
// ==========================================

model WorkflowSimulationScenario {
  id               String   @id @default(uuid())
  workspaceId      String
  workflowId       String
  name             String
  description      String?
  injectedFaults   Json     @default("[]")
  syntheticTrigger Json     @default("{}")
  mockOutputs      Json     @default("{}")
  expectedOutcome  String   @default("SIMULATED_SUCCESS") // SIMULATED_SUCCESS, SIMULATED_FAILURE, SIMULATED_TIMEOUT
  assertions       Json     @default("[]")
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow         Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs             WorkflowSimulationRun[]

  @@index([workflowId])
  @@index([workspaceId])
  @@map("workflow_simulation_scenarios")
}

model WorkflowSimulationRun {
  id                      String   @id @default(uuid())
  workspaceId             String
  workflowId              String
  scenarioId              String?
  workflowArtifactHash    String   // Bound SHA-256 canonical hash
  releaseArtifactId       String?
  engineVersion           String   @default("digital-twin/v1")
  status                  String   // SIMULATED_SUCCESS, SIMULATED_FAILURE, SIMULATED_TIMEOUT, BLOCKED_BY_POLICY
  virtualDurationMs       Int      @default(0)
  realDurationMs          Int      @default(0)
  nodeOutcomes            Json     @default("{}")
  timeline                Json     @default("[]")
  assertionResults        Json     @default("[]")
  allAssertionsPassed     Boolean  @default(true)
  unsimulatableNodeCount  Int      @default(0)
  sideEffectsBlockedCount Int      @default(0)
  executedByUserId        String?
  createdAt               DateTime @default(now())

  workspace               Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow                Workflow                    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  scenario                WorkflowSimulationScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  releaseArtifact         WorkflowReleaseArtifact?    @relation(fields: [releaseArtifactId], references: [id], onDelete: SetNull)

  @@index([workflowArtifactHash, status])
  @@index([workflowId, createdAt])
  @@index([workspaceId])
  @@map("workflow_simulation_runs")
}

model ChaosExperiment {
  id                  String   @id @default(uuid())
  workspaceId         String
  name                String
  description         String?
  targetEnvironmentId String
  faultType           String   // WORKER_LOSS, QUEUE_BACKPRESSURE, TRANSIENT_5XX, RATE_LIMITING, DATABASE_LATENCY, OUTBOX_DELIVERY_FAILURE, WORKER_HEARTBEAT_EXPIRY
  targetScope         Json     @default("{}")
  status              String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, RUNNING, COMPLETED, ABORTED, CLEANED_UP
  maxDurationSeconds  Int      @default(60)
  authorizedByUserId  String?
  authorizedAt        DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cleanupStatus       String   @default("PENDING") // PENDING, CLEANED_UP, FAILED
  cleanupAt           DateTime?
  recoveryMetrics     Json?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targetEnvironment   WorkflowEnvironment @relation(fields: [targetEnvironmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([targetEnvironmentId])
  @@map("chaos_experiments")
}

model WorkflowOptimizationCandidate {
  id                     String   @id @default(uuid())
  workspaceId            String
  workflowId             String
  baselineArtifactHash   String
  candidateArtifactHash  String
  title                  String
  summary                String
  proposedChanges        Json     @default("{}")
  structuralDiff         Json     @default("{}")
  baselineMetrics        Json     @default("{}")
  candidateMetrics       Json     @default("{}")
  recommendations        Json     @default("[]")
  status                 String   @default("DRAFT") // DRAFT, REVIEWED, PROMOTED, DISCARDED
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow               Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, status])
  @@index([workspaceId])
  @@map("workflow_optimization_candidates")
}
