// Prisma Schema for FlowForge Automation - Phase 2 Execution Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum IntegrationStatus {
  AVAILABLE
  PLANNED
  BETA
}

enum AuthType {
  NONE
  API_KEY
  OAUTH2
  BEARER_TOKEN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMembership[]
  sessions    Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       WorkspaceMembership[]
  workflows         Workflow[]
  connectedAccounts ConnectedAccount[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

model Workflow {
  id            String         @id @default(uuid())
  workspaceId   String
  name          String
  description   String?
  status        WorkflowStatus @default(DRAFT)
  triggerType   String?
  webhookSlug   String?        @unique
  webhookSecret String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions           WorkflowVersion[]
  executions         WorkflowExecution[]
  webhookReceipts    WebhookEventReceipt[]
  scheduledTriggers  ScheduledTrigger[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("workflows")
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String
  version    Int      @default(1)
  nodes      Json     @default("[]")
  edges      Json     @default("[]")
  viewport   Json?
  isValid    Boolean  @default(true)
  createdAt  DateTime @default(now())

  workflow   Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model IntegrationDefinition {
  id               String            @id @default(uuid())
  key              String            @unique
  name             String
  description      String
  category         String
  status           IntegrationStatus @default(AVAILABLE)
  authType         AuthType          @default(NONE)
  isBuiltin        Boolean           @default(false)
  iconName         String
  accentColor      String            @default("#6366f1")
  documentationUrl String?
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("integration_definitions")
}

model ConnectedAccount {
  id             String    @id @default(uuid())
  workspaceId    String
  integrationKey String
  name           String
  credentials    Json      @default("{}") // AES-256-GCM encrypted tokens & secrets
  metadata       Json      @default("{}") // Identity metadata (account email, team name, user id)
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, ERROR
  scopes         String[]  @default([])
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, integrationKey])
  @@map("connected_accounts")
}

model OAuthAuthorizationState {
  id           String   @id @default(uuid())
  state        String   @unique
  provider     String
  workspaceId  String
  userId       String
  codeVerifier String?
  redirectUri  String?
  metadata     Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([state])
  @@index([workspaceId])
  @@map("oauth_authorization_states")
}

model WebhookEventReceipt {
  id          String   @id @default(uuid())
  workflowId  String
  eventId     String
  sourceIp    String?
  headers     Json?
  payload     Json?
  executionId String?
  createdAt   DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, eventId])
  @@index([workflowId, createdAt])
  @@map("webhook_event_receipts")
}

model ScheduledTrigger {
  id             String    @id @default(uuid())
  workflowId     String
  cronExpression String
  timezone       String    @default("UTC")
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  status         String    @default("ACTIVE")
  jobId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status, nextRunAt])
  @@map("scheduled_triggers")
}

model WorkflowExecution {
  id             String          @id @default(uuid())
  workflowId     String
  versionId      String?
  status         ExecutionStatus @default(PENDING)
  attempt        Int             @default(1)
  maxAttempts    Int             @default(3)
  retryOfId      String?
  correlationId  String?
  errorCategory  String?
  triggerEvent   Json?
  errorSummary   String?
  executionTrace Json?
  nextRetryAt    DateTime?
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime        @default(now())

  workflow Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version  WorkflowVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  steps    WorkflowStepExecution[]

  @@index([workflowId, status])
  @@index([workflowId, createdAt])
  @@index([correlationId])
  @@map("workflow_executions")
}

model WorkflowStepExecution {
  id            String          @id @default(uuid())
  executionId   String
  nodeId        String
  nodeName      String
  nodeType      String
  status        ExecutionStatus @default(PENDING)
  attempt       Int             @default(1)
  correlationId String?
  errorCategory String?
  inputData     Json?
  outputData    Json?
  errorMessage  String?
  durationMs    Int?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("workflow_step_executions")
}
