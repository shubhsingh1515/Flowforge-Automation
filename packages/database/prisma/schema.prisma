// Prisma Schema for FlowForge Automation - Phase 4 Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  SUCCESS
  FAILED
  CANCELLED
}

enum IntegrationStatus {
  AVAILABLE
  PLANNED
  BETA
}

enum AuthType {
  NONE
  API_KEY
  OAUTH2
  BEARER_TOKEN
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMembership[]
  sessions    Session[]
  ssoIdentities SsoUserIdentity[]
  notifications Notification[]
  customerFeedback CustomerFeedback[]
  organizationMemberships OrganizationMembership[]
  teamMemberships         TeamMember[]
  workflowReviewsAuthored WorkflowReview[] @relation("ReviewAuthor")
  workflowReviewsReviewed WorkflowReview[] @relation("ReviewReviewer")
  reviewComments          WorkflowReviewComment[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       WorkspaceMembership[]
  workflows         Workflow[]
  connectedAccounts ConnectedAccount[]
  subscription      WorkspaceSubscription?
  usageRecords      UsageRecord[]
  invitations       WorkspaceInvitation[]
  templates          WorkflowTemplate[]
  onboarding         WorkspaceOnboarding?
  apiKeys            ApiKey[]
  outboundWebhooks   OutboundWebhook[]
  customIntegrations CustomIntegration[]
  auditLogs          WorkspaceAuditLog[]
  marketplaceListings    MarketplaceListing[] @relation("WorkspaceMarketplaceListings")
  marketplaceInstalls    MarketplaceInstallation[]
  governancePolicy       WorkspaceGovernancePolicy?
  retentionPolicy        WorkspaceRetentionPolicy?
  dataExportRequests     DataExportRequest[]
  deletionRequests       WorkspaceDeletionRequest[]
  ssoProvider            WorkspaceSsoProvider?
  ssoIdentities          SsoUserIdentity[]
  ssoAuthStates          SsoAuthorizationState[]
  scimTokens             ScimProvisioningToken[]
  usageAlertConfig       WorkspaceUsageAlertConfig?
  usageAlertEvents       WorkspaceUsageAlertEvent[]
  notifications          Notification[]
  customerFeedback       CustomerFeedback[]
  supportBundles         SupportBundle[]
  environments           WorkflowEnvironment[]
  releaseArtifacts       WorkflowReleaseArtifact[]
  deployments            WorkflowDeployment[]
  deploymentPolicies     DeploymentPolicy[]
  testCases              WorkflowTestCase[]
  testRuns               WorkflowTestRun[]
  teams                  Team[]
  resourcePermissions    ResourcePermission[]
  workflowReviews        WorkflowReview[]
  reliabilityObjectives  ReliabilityObjective[]
  complianceExportJobs   ComplianceExportJob[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

model Workflow {
  id            String         @id @default(uuid())
  workspaceId   String
  name          String
  description   String?
  status        WorkflowStatus @default(DRAFT)
  triggerType   String?
  webhookSlug   String?        @unique
  webhookSecret String?
  ownerUserId       String?
  owningTeamId      String?
  stewardUserId     String?
  criticality       String         @default("TIER_3_STANDARD")
  businessDomain    String?
  lifecycleStatus   String         @default("DRAFT")
  nextReviewDate    DateTime?
  escalationContact String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions          WorkflowVersion[]
  executions        WorkflowExecution[]
  webhookReceipts   WebhookEventReceipt[]
  scheduledTriggers ScheduledTrigger[]
  approvals         WorkflowApproval[]
  releaseArtifacts  WorkflowReleaseArtifact[]
  deployments       WorkflowDeployment[]
  testCases         WorkflowTestCase[]
  testRuns          WorkflowTestRun[]
  owningTeam        Team?                  @relation("TeamWorkflows", fields: [owningTeamId], references: [id], onDelete: SetNull)
  reviews           WorkflowReview[]
  reliabilityObjectives ReliabilityObjective[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("workflows")
}

model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String
  version       Int      @default(1)
  changeSummary String?
  createdById   String?
  nodes      Json     @default("[]")
  edges      Json     @default("[]")
  viewport   Json?
  isValid    Boolean  @default(true)
  createdAt  DateTime @default(now())

  workflow   Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions       WorkflowExecution[]
  releaseArtifacts WorkflowReleaseArtifact[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model IntegrationDefinition {
  id               String            @id @default(uuid())
  key              String            @unique
  name             String
  description      String
  category         String
  status           IntegrationStatus @default(AVAILABLE)
  authType         AuthType          @default(NONE)
  isBuiltin        Boolean           @default(false)
  iconName         String
  accentColor      String            @default("#6366f1")
  documentationUrl String?
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("integration_definitions")
}

model ConnectedAccount {
  id             String    @id @default(uuid())
  workspaceId    String
  integrationKey String
  name           String
  credentials    Json      @default("{}") // AES-256-GCM encrypted tokens & secrets
  metadata       Json      @default("{}") // Identity metadata (account email, team name, user id)
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, ERROR
  scopes         String[]  @default([])
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace          Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentialBindings EnvironmentCredentialBinding[]

  @@index([workspaceId])
  @@index([workspaceId, integrationKey])
  @@map("connected_accounts")
}

model OAuthAuthorizationState {
  id           String   @id @default(uuid())
  state        String   @unique
  provider     String
  workspaceId  String
  userId       String
  codeVerifier String?
  redirectUri  String?
  metadata     Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([state])
  @@index([workspaceId])
  @@map("oauth_authorization_states")
}

model WebhookEventReceipt {
  id          String   @id @default(uuid())
  workflowId  String
  eventId     String
  sourceIp    String?
  headers     Json?
  payload     Json?
  executionId String?
  createdAt   DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, eventId])
  @@index([workflowId, createdAt])
  @@map("webhook_event_receipts")
}

model ScheduledTrigger {
  id             String    @id @default(uuid())
  workflowId     String
  cronExpression String
  timezone       String    @default("UTC")
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  status         String    @default("ACTIVE")
  jobId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status, nextRunAt])
  @@map("scheduled_triggers")
}

model WorkflowExecution {
  id                 String          @id @default(uuid())
  workflowId         String
  versionId          String?
  environmentId      String?
  releaseArtifactId  String?
  status             ExecutionStatus @default(PENDING)
  attempt            Int             @default(1)
  maxAttempts        Int             @default(3)
  retryOfId          String?
  correlationId      String?
  traceparent        String?
  diagnostics        Json?
  timeline           Json?
  errorCategory      String?
  triggerEvent       Json?
  errorSummary       String?
  executionTrace     Json?
  executionState     Json?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  resumedAt          DateTime?
  nextRetryAt        DateTime?
  startedAt          DateTime        @default(now())
  finishedAt         DateTime?
  durationMs         Int?
  createdAt          DateTime        @default(now())

  workflow  Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version   WorkflowVersion?        @relation(fields: [versionId], references: [id], onDelete: SetNull)
  steps     WorkflowStepExecution[]
  approvals WorkflowApproval[]

  @@index([workflowId, status])
  @@index([workflowId, createdAt])
  @@index([correlationId])
  @@map("workflow_executions")
}

model WorkflowStepExecution {
  id            String          @id @default(uuid())
  executionId   String
  nodeId        String
  nodeName      String
  nodeType      String
  status        ExecutionStatus @default(PENDING)
  attempt       Int             @default(1)
  correlationId String?
  errorCategory String?
  inputData     Json?
  outputData    Json?
  errorMessage  String?
  iteration     Int?
  branch        String?
  durationMs    Int?
  startedAt     DateTime        @default(now())
  finishedAt    DateTime?

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("workflow_step_executions")
}

model WorkflowApproval {
  id              String          @id @default(uuid())
  workspaceId     String
  workflowId      String
  executionId     String
  nodeId          String
  stepId          String?
  title           String
  description     String?
  context         Json?
  status          String          @default("PENDING") // PENDING, APPROVED, REJECTED, TIMED_OUT, CANCELLED
  requiredRole    WorkspaceRole?
  decision        String?         // APPROVED, REJECTED
  comment         String?
  decidedByUserId String?
  decidedAt       DateTime?
  timeoutSeconds  Int?
  expiresAt       DateTime?
  resumeNodeId    String?
  rejectNodeId    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([executionId])
  @@index([status, expiresAt])
  @@map("workflow_approvals")
}

model WorkspaceSubscription {
  id                   String             @id @default(uuid())
  workspaceId          String             @unique
  planTier             PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("workspace_subscriptions")
}

model UsageRecord {
  id             String   @id @default(uuid())
  workspaceId    String
  metricType     String   @default("WORKFLOW_EXECUTION") // WORKFLOW_EXECUTION, STEP_EXECUTION
  quantity       Int      @default(1)
  executionId    String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, metricType])
  @@map("usage_records")
}

model BillingWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  provider    String   @default("STRIPE")
  payload     Json?
  processedAt DateTime @default(now())

  @@index([eventType])
  @@map("billing_webhook_events")
}

model WorkspaceInvitation {
  id              String           @id @default(uuid())
  workspaceId     String
  email           String
  role            WorkspaceRole    @default(MEMBER)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
  @@map("workspace_invitations")
}


model WorkflowTemplate {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  title                String
  description          String
  category             String
  tags                 String[] @default([])
  difficulty           String   @default("BEGINNER")
  triggerType          String
  actionType           String
  requiredIntegrations String[] @default([])
  setupGuide           String?
  nodes                Json     @default("[]")
  edges                Json     @default("[]")
  isPlatform           Boolean  @default(false)
  reviewStatus         String   @default("PUBLISHED")
  publisherName        String?
  version              Int      @default(1)
  workspaceId          String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace            Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([workspaceId])
  @@index([isPlatform])
  @@map("workflow_templates")
}

model WorkspaceOnboarding {
  id                   String   @id @default(uuid())
  workspaceId          String   @unique
  hasCreatedWorkflow   Boolean  @default(false)
  hasTestedWorkflow    Boolean  @default(false)
  hasActivatedWorkflow Boolean  @default(false)
  hasConnectedAccount  Boolean  @default(false)
  hasUsedTemplate      Boolean  @default(false)
  hasInvitedMember     Boolean  @default(false)
  dismissed            Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_onboarding")
}


model ApiKey {
  id          String    @id @default(uuid())
  name        String
  keyPrefix   String
  keyHash     String    @unique
  workspaceId String
  createdById String
  scopes      String[]  @default([])
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model OutboundWebhook {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  url         String
  secret      String
  events      String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId, active])
  @@map("outbound_webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String
  workspaceId  String
  eventId      String
  eventType    String
  payload      Json
  status       String    @default("PENDING")
  statusCode   Int?
  responseBody String?
  errorMessage String?
  attempt      Int       @default(1)
  maxAttempts  Int       @default(3)
  durationMs   Int?
  nextRetryAt  DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([workspaceId, createdAt])
  @@index([eventId])
  @@map("webhook_deliveries")
}

model CustomIntegration {
  id             String   @id @default(uuid())
  workspaceId    String
  key            String
  name           String
  description    String?
  category       String   @default("Custom")
  status         String   @default("DRAFT")
  currentVersion Int      @default(1)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  CustomIntegrationVersion[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("custom_integrations")
}

model CustomIntegrationVersion {
  id            String   @id @default(uuid())
  integrationId String
  version       Int      @default(1)
  definition    Json     @default("{}")
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())

  integration CustomIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, version])
  @@map("custom_integration_versions")
}

model WorkspaceAuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorId     String
  actorType   String   @default("USER")
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("workspace_audit_logs")
}


// ==========================================
// PHASE 9: MARKETPLACE & GOVERNANCE MODELS
// ==========================================

model MarketplaceListing {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  title                 String
  description           String
  category              String   @default("Productivity")
  iconName              String   @default("Puzzle")
  accentColor           String   @default("#6366f1")
  publisherName         String   @default("FlowForge Platform")
  publisherWorkspaceId  String?
  integrationKey        String?
  customIntegrationId   String?
  currentVersion        Int      @default(1)
  visibility            String   @default("PUBLIC") // PUBLIC, WORKSPACE, PRIVATE
  reviewStatus          String   @default("PUBLISHED") // DRAFT, IN_REVIEW, PUBLISHED, REJECTED, DEPRECATED, UNPUBLISHED
  rejectionReason       String?
  capabilities          String[] @default([])
  supportedTriggers     String[] @default([])
  supportedActions      String[] @default([])
  authRequirements      String   @default("OAuth 2.0 or API Key")
  documentationUrl      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  publisherWorkspace    Workspace? @relation("WorkspaceMarketplaceListings", fields: [publisherWorkspaceId], references: [id], onDelete: SetNull)
  installations         MarketplaceInstallation[]

  @@index([category])
  @@index([reviewStatus])
  @@index([visibility])
  @@map("marketplace_listings")
}

model MarketplaceInstallation {
  id               String   @id @default(uuid())
  workspaceId      String
  listingId        String
  installedVersion Int      @default(1)
  status           String   @default("ACTIVE") // ACTIVE, DISABLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, listingId])
  @@index([workspaceId])
  @@map("marketplace_installations")
}

model WorkspaceGovernancePolicy {
  id                          String   @id @default(uuid())
  workspaceId                 String   @unique
  allowCustomIntegrations     Boolean  @default(true)
  allowMarketplacePublishing  Boolean  @default(false)
  allowCommunityTemplates     Boolean  @default(true)
  requireHttpsWebhooks        Boolean  @default(true)
  maxApiKeyLifetimeDays       Int?     @default(365)
  restrictIntegrationsToAdmin Boolean  @default(false)
  requireWorkflowOwner        Boolean  @default(false)
  requireReviewForCritical    Boolean  @default(true)
  requirePassingTests         Boolean  @default(false)
  enforceReliabilitySlo       Boolean  @default(false)
  maxExecutionDurationMs      Int?     @default(300000)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_governance_policies")
}

model WorkspaceRetentionPolicy {
  id                           String   @id @default(uuid())
  workspaceId                  String   @unique
  executionRetentionDays       Int      @default(30)
  webhookDeliveryRetentionDays  Int      @default(14)
  auditLogRetentionDays        Int      @default(90)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_retention_policies")
}

model DataExportRequest {
  id            String    @id @default(uuid())
  workspaceId   String
  requestedById String
  status        String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  downloadUrl   String?
  fileSizeBytes Int?
  recordCount   Int?
  errorMessage  String?
  expiresAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("data_export_requests")
}

model WorkspaceDeletionRequest {
  id                  String    @id @default(uuid())
  workspaceId         String
  requestedById       String
  status              String    @default("PENDING") // PENDING, CONFIRMED, PROCESSING, COMPLETED, CANCELLED
  confirmationToken   String?
  reason              String?
  scheduledDeletionAt DateTime?
  confirmedAt         DateTime?
  createdAt           DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("workspace_deletion_requests")
}


// ==========================================
// PHASE 10: ENTERPRISE IDENTITY & RELIABILITY
// ==========================================

model WorkspaceSsoProvider {
  id                            String   @id @default(uuid())
  workspaceId                   String   @unique
  name                          String   @default("Enterprise OIDC")
  issuerUrl                     String
  authorizationEndpoint         String
  tokenEndpoint                 String
  userinfoEndpoint              String?
  clientId                      String
  encryptedClientSecret         String
  scopes                        String   @default("openid email profile")
  enforceSso                    Boolean  @default(false)
  allowPasswordFallbackForAdmins Boolean @default(true)
  lastTestedAt                  DateTime?
  lastTestStatus                String?
  lastTestError                 String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  identities SsoUserIdentity[]

  @@map("workspace_sso_providers")
}

model SsoUserIdentity {
  id                  String   @id @default(uuid())
  userId              String
  workspaceId         String
  providerId          String
  externalSubjectId   String
  externalEmail       String
  metadata            Json?
  lastAuthenticatedAt DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider  WorkspaceSsoProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, externalSubjectId])
  @@index([userId])
  @@index([workspaceId, externalEmail])
  @@map("sso_user_identities")
}

model SsoAuthorizationState {
  id           String   @id @default(uuid())
  workspaceId  String
  state        String   @unique
  nonce        String
  codeVerifier String?
  redirectUri  String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([workspaceId])
  @@map("sso_authorization_states")
}

model ScimProvisioningToken {
  id          String    @id @default(uuid())
  workspaceId String
  name        String    @default("Primary SCIM Token")
  tokenHash   String    @unique
  tokenPrefix String
  status      String    @default("ACTIVE")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("scim_provisioning_tokens")
}

model ExecutionReconciliationLog {
  id             String   @id @default(uuid())
  executionId    String
  workflowId     String
  workspaceId    String
  previousStatus String
  newStatus      String
  reason         String
  actionTaken    String
  reconciledAt   DateTime @default(now())

  @@index([workspaceId, reconciledAt])
  @@index([executionId])
  @@map("execution_reconciliation_logs")
}

model OperationalAlertRule {
  id              String   @id @default(uuid())
  metricName      String
  operator        String
  threshold       Float
  durationMinutes Int      @default(5)
  severity        String   @default("WARNING")
  isEnabled       Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("operational_alert_rules")
}

// ==========================================
// PHASE 11: CUSTOMER SUCCESS, USAGE INTELLIGENCE & NOTIFICATIONS
// ==========================================

model WorkspaceUsageAlertConfig {
  id           String   @id @default(uuid())
  workspaceId  String   @unique
  threshold50  Boolean  @default(true)
  threshold80  Boolean  @default(true)
  threshold90  Boolean  @default(true)
  threshold100 Boolean  @default(true)
  notifyEmail  Boolean  @default(true)
  notifyInApp  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_usage_alert_configs")
}

model WorkspaceUsageAlertEvent {
  id               String   @id @default(uuid())
  workspaceId      String
  billingCycleKey  String   // e.g. "2026-10" or timestamp cycle
  thresholdPercent Int      // 50, 80, 90, 100
  executionsCount  Int
  quotaLimit       Int
  triggeredAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, billingCycleKey, thresholdPercent])
  @@index([workspaceId, billingCycleKey])
  @@map("workspace_usage_alert_events")
}

model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String?   // null indicates notification applies to all workspace members
  type        String    // USAGE_ALERT, EXECUTION_FAILED, APPROVAL_REQUESTED, WEBHOOK_FAILED, DATA_EXPORT, SYSTEM
  title       String
  message     String
  link        String?
  category    String    @default("info") // info, warning, error, success
  read        Boolean   @default(false)
  readAt      DateTime?
  metadata    Json?     @default("{}")
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, read, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

model CustomerFeedback {
  id           String   @id @default(uuid())
  workspaceId  String
  userId       String
  category     String   // BUG, FEATURE_REQUEST, USABILITY, GENERAL
  rating       Int?     // 1 to 5
  comment      String
  contactEmail String?
  metadata     Json?    @default("{}")
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("customer_feedback")
}

model SupportBundle {
  id                String   @id @default(uuid())
  workspaceId       String
  requestedByUserId String
  status            String   @default("COMPLETED")
  summary           String
  payload           Json     // sanitized workspace diagnostic payload
  sizeBytes         Int      @default(0)
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@map("support_bundles")
}



// ==========================================
// PHASE 12: WORKFLOW ENVIRONMENTS & DEPLOYMENTS
// ==========================================

model WorkflowEnvironment {
  id                      String   @id @default(uuid())
  workspaceId             String
  name                    String
  slug                    String
  type                    String   @default("DEVELOPMENT") // DEVELOPMENT, STAGING, PRODUCTION, CUSTOM
  description             String?
  isProtected             Boolean  @default(false)
  requireApproval         Boolean  @default(false)
  requirePassingTests     Boolean  @default(false)
  activeReleaseArtifactId String?
  deployedAt              DateTime?
  deployedByUserId        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace               Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variables               EnvironmentVariable[]
  bindings                EnvironmentCredentialBinding[]
  deployments             WorkflowDeployment[]
  testRuns                WorkflowTestRun[]
  policy                  DeploymentPolicy?

  @@unique([workspaceId, slug])
  @@index([workspaceId, type])
  @@map("workflow_environments")
}

model EnvironmentVariable {
  id              String   @id @default(uuid())
  workspaceId     String
  environmentId   String
  key             String
  value           String   // Plaintext or AES-256-GCM ciphertext
  isSecret        Boolean  @default(false)
  description     String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  environment     WorkflowEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([workspaceId])
  @@index([environmentId])
  @@map("environment_variables")
}

model EnvironmentCredentialBinding {
  id                 String   @id @default(uuid())
  workspaceId        String
  environmentId      String
  integrationKey     String
  connectedAccountId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  environment        WorkflowEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount    @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([environmentId, integrationKey])
  @@index([workspaceId])
  @@index([connectedAccountId])
  @@map("environment_credential_bindings")
}

model WorkflowReleaseArtifact {
  id                  String   @id @default(uuid())
  workspaceId         String
  workflowId          String
  workflowVersionId   String?
  versionNumber       Int
  releaseNumber       Int
  formatVersion       String   @default("flowforge.release/v1")
  contentHash         String
  canonicalDefinition Json
  summary             String?
  status              String   @default("READY") // READY, DEPRECATED
  createdById         String?
  createdAt           DateTime @default(now())

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow            Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion     WorkflowVersion?     @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  deployments         WorkflowDeployment[]
  testRuns            WorkflowTestRun[]

  @@unique([workflowId, releaseNumber])
  @@index([workspaceId, contentHash])
  @@index([workflowId, createdAt])
  @@map("workflow_release_artifacts")
}

model WorkflowDeployment {
  id                        String    @id @default(uuid())
  workspaceId               String
  workflowId                String
  releaseArtifactId         String
  environmentId             String
  status                    String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, DEPLOYING, DEPLOYED, FAILED, CANCELLED, ROLLED_BACK, SUPERSEDED
  previousReleaseArtifactId String?
  diffSummary               Json?
  validationResults         Json?
  initiatedByUserId         String
  approvedByUserId          String?
  approvedAt                DateTime?
  rollbackOfDeploymentId    String?
  deployedAt                DateTime?
  completedAt               DateTime?
  failureReason             String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  workspace                 Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow                  Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  releaseArtifact           WorkflowReleaseArtifact @relation(fields: [releaseArtifactId], references: [id], onDelete: Cascade)
  environment               WorkflowEnvironment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, environmentId, status])
  @@index([workflowId, environmentId])
  @@index([releaseArtifactId])
  @@map("workflow_deployments")
}

model DeploymentPolicy {
  id                   String   @id @default(uuid())
  workspaceId          String
  environmentId        String   @unique
  requireApproval      Boolean  @default(false)
  requirePassingTests  Boolean  @default(false)
  preventSelfApproval  Boolean  @default(true)
  allowedPromoterRoles String[] @default(["OWNER", "ADMIN", "MEMBER"])
  allowedApproverRoles String[] @default(["OWNER", "ADMIN"])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment          WorkflowEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("deployment_policies")
}

model WorkflowTestCase {
  id             String   @id @default(uuid())
  workspaceId    String
  workflowId     String
  name           String
  description    String?
  triggerPayload Json     @default("{}")
  mockOutputs    Json     @default("{}")
  expectedStatus String   @default("SUCCESS") // SUCCESS, FAILED
  assertions     Json     @default("[]")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow       Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  testRuns       WorkflowTestRun[]

  @@index([workflowId])
  @@index([workspaceId])
  @@map("workflow_test_cases")
}

model WorkflowTestRun {
  id                 String   @id @default(uuid())
  workspaceId        String
  workflowId         String
  testCaseId         String
  releaseArtifactId  String?
  releaseContentHash String?
  environmentId      String?
  mode               String   @default("DRY_RUN") // DRY_RUN, MOCKED, REAL_INTEGRATION
  status             String   // PASSED, FAILED, ERROR
  assertionResults   Json     @default("[]")
  nodeResults        Json     @default("{}")
  durationMs         Int      @default(0)
  errorMessage       String?
  executedByUserId   String?
  createdAt          DateTime @default(now())

  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow           Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  testCase           WorkflowTestCase         @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  releaseArtifact    WorkflowReleaseArtifact? @relation(fields: [releaseArtifactId], references: [id], onDelete: SetNull)
  environment        WorkflowEnvironment?     @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([testCaseId, status])
  @@index([releaseContentHash, status])
  @@index([workspaceId])
  @@map("workflow_test_runs")
}

// ==========================================
// PHASE 14: ENTERPRISE COLLABORATION & GOVERNANCE
// ==========================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces  Workspace[]
  memberships OrganizationMembership[]
  teams       Team[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String?
  workspaceId    String
  name           String
  slug           String
  description    String?
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  workflows    Workflow[]    @relation("TeamWorkflows")

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER") // LEAD, MEMBER
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model ResourcePermission {
  id           String   @id @default(uuid())
  workspaceId  String
  resourceType String   // WORKFLOW, ENVIRONMENT, FOLDER
  resourceId   String
  subjectType  String   // USER, TEAM
  subjectId    String
  actions      String[] @default(["VIEW"]) // VIEW, EDIT, RUN, APPROVE, DEPLOY, MANAGE_PERMISSIONS
  grantedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resourceType, resourceId])
  @@index([subjectType, subjectId])
  @@map("resource_permissions")
}

model WorkflowReview {
  id                    String    @id @default(uuid())
  workspaceId           String
  workflowId            String
  workflowVersionNumber Int
  releaseArtifactId     String?
  contentHash           String
  title                 String
  changeSummary         String?
  authorUserId          String
  status                String    @default("SUBMITTED") // SUBMITTED, CHANGES_REQUESTED, APPROVED, REJECTED, SUPERSEDED
  reviewerUserId        String?
  decisionReason        String?
  decidedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  author    User                    @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  reviewer  User?                   @relation("ReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  comments  WorkflowReviewComment[]

  @@index([workspaceId, workflowId, status])
  @@index([contentHash])
  @@map("workflow_reviews")
}

model WorkflowReviewComment {
  id           String   @id @default(uuid())
  reviewId     String
  authorUserId String
  nodeId       String?
  comment      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  review WorkflowReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("workflow_review_comments")
}

model ReliabilityObjective {
  id                   String    @id @default(uuid())
  workspaceId          String
  workflowId           String?
  name                 String
  targetMetric         String    // SUCCESS_RATE, P95_LATENCY, MAX_DURATION
  targetValue          Float
  evaluationWindowDays Int       @default(14)
  status               String    @default("MET") // MET, AT_RISK, BREACHED, INSUFFICIENT_DATA
  currentValue         Float?
  errorBudgetRemaining Float?
  lastEvaluatedAt      DateTime?
  alertCooldownUntil   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workflowId])
  @@map("reliability_objectives")
}

model ComplianceExportJob {
  id                String    @id @default(uuid())
  workspaceId       String
  requestedByUserId String
  scope             String    @default("ALL") // AUDIT_LOGS, GOVERNANCE, REVIEWS, RELEASES, FULL
  timeRangeStart    DateTime
  timeRangeEnd      DateTime
  status            String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, EXPIRED
  downloadToken     String?   @unique
  fileSizeBytes     Int?
  recordCount       Int?
  sanitizedPayload  Json?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("compliance_export_jobs")
}
