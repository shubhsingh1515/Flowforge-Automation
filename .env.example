# FlowForge Automation - Environment Configuration Example

# Product Branding
NEXT_PUBLIC_APP_NAME="FlowForge Automation"
NEXT_PUBLIC_APP_DESCRIPTION="Next-generation visual workflow automation platform"

# Database (PostgreSQL)
DATABASE_URL="postgresql://flowforge:flowforge_dev_password@localhost:5432/flowforge_db?schema=public"

# Redis Cache & Background Execution Queue (Phase 2 & 3)
REDIS_URL="redis://localhost:6379"

# Backend API Configuration
PORT=4000
NODE_ENV=development
API_PREFIX="/api/v1"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Authentication Security
JWT_SECRET="flowforge-development-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="flowforge-development-cookie-secret-key-at-least-32-chars"

# Credential Encryption Vault (Phase 3 - 32 bytes hex or string)
CREDENTIAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Third-Party OAuth 2.0 Credentials (Phase 3)
# Slack App Settings (https://api.slack.com/apps)
# Redirect URI: http://localhost:4000/api/v1/oauth/slack/callback
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:4000/api/v1/oauth/slack/callback"

# Google Cloud Console Settings (https://console.cloud.google.com/apis/credentials)
# Enabled APIs: Google Sheets API, Gmail API, Google Drive API
# Redirect URI: http://localhost:4000/api/v1/oauth/google-sheets/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/oauth/google-sheets/callback"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
